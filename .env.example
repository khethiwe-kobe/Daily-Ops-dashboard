# Pooled Postgres connection string (Neon / Supabase / Vercel Postgres)
POSTGRES_URL=postgres://user:password@host/db?sslmode=require

# Long random string. Gates the founder page and its API.
SYNC_KEY=change-me-to-something-long-and-random

# Set to 1 to force matric dance voting (/vote) closed. Normally close it from the board instead.
# PROM_VOTING_CLOSED=1

# Innaderm Ops dashboard (/innaderm). See README.
INNADERM_ADMIN_KEY=change-me-long-random-bootstrap-admin-key
INNADERM_SHOPIFY_TOKEN=shpat_xxx
